@echo off
chcp 65001 >nul 2>&1
setlocal
title Antigravity 汉化一键工具
set "SELF=%~f0"
set "WORK=%TEMP%\AgyCnTool"
set "AGYSELF=%~f0"
set "AGYWORK=%WORK%"
if exist "%WORK%" rmdir /s /q "%WORK%"
mkdir "%WORK%\app" 2>nul
echo.
echo ====== Antigravity 汉化一键工具 ======
echo [1] 安装简体中文
echo [2] 安装繁体中文
echo [3] 卸载还原官方英文
echo [Q] 退出
set "OP="
set /p "OP=请选择 [1/2/3/Q]: "
if /i "%OP%"=="Q" exit /b 0
if "%OP%"=="3" goto huifu
if "%OP%"=="2" set "TW=--tw"
if "%OP%"=="1" goto brand
if "%OP%"=="2" goto brand
echo 输入不对，退出。
pause
exit /b 1

:brand
echo.
echo 请选择左上角品牌显示方式：
echo [1] 保持英文 Antigravity（推荐）
echo [2] 隐藏品牌名
echo [3] 汉化为品牌名（反重力）
set "BC=1"
set /p "BC=请选择 [1/2/3] (直接按 Enter 默认为 1): "
set "BRAND=english"
if "%BC%"=="2" set "BRAND=hidden"
if "%BC%"=="3" set "BRAND=translated"
set "ARGS=%TW% --brand-title %BRAND%"
goto runtime

:huifu
set "ARGS=--huifu"

:runtime
echo.
echo 正在准备运行环境...
set "NODE="
set "USEEXE="
where node >nul 2>nul && set "NODE=node"
if defined NODE goto extract
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=@(); $roots='HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*'; foreach($r in $roots){ Get-ItemProperty $r -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like '*Antigravity*' } | ForEach-Object { if($_.InstallLocation){ $c += (Join-Path $_.InstallLocation 'Antigravity.exe') } } }; $c += (Join-Path $env:LOCALAPPDATA 'Programs\Antigravity\Antigravity.exe'); $c += (Join-Path $env:ProgramFiles 'Antigravity\Antigravity.exe'); $c += (Join-Path $env:LOCALAPPDATA 'Antigravity\Antigravity.exe'); $f=$c | Where-Object { Test-Path $_ } | Select-Object -First 1; if($f){ [IO.File]::WriteAllText((Join-Path $env:AGYWORK 'exe.txt'), $f) }"
if not exist "%WORK%\exe.txt" goto manual
set /p "AGYEXE="<"%WORK%\exe.txt"
if not defined AGYEXE goto manual
set "NODE=%AGYEXE%"
set "USEEXE=1"
goto probe

:manual
echo 没自动找到 Antigravity.exe。
set "AHOME="
set /p "AHOME=请粘贴 Antigravity 安装目录 (如 C:\Program Files\Antigravity): "
if not exist "%AHOME%\Antigravity.exe" goto notfound
set "NODE=%AHOME%\Antigravity.exe"
set "USEEXE=1"
set "MANUALDIR=1"
goto probe

:notfound
echo [错误] 找不到 Antigravity.exe，无法继续。装了系统 Node.js 也可直接运行本脚本。
pause
exit /b 1

:probe
if defined USEEXE set "ELECTRON_RUN_AS_NODE=1"
"%NODE%" -e "process.stdout.write('NODEOK')" > "%WORK%\probe.txt" 2>nul
findstr /c:"NODEOK" "%WORK%\probe.txt" >nul || goto probefail
goto extract

:probefail
echo [错误] 运行环境自检失败 (ELECTRON_RUN_AS_NODE 不可用)。请安装 Node.js 后再双击本脚本。
pause
exit /b 1

:extract
echo 正在释放汉化文件...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$raw=[IO.File]::ReadAllText($env:AGYSELF); $m='::__PAYLOAD__::'; $i=$raw.LastIndexOf($m); $b64=$raw.Substring($i+$m.Length) -replace '[^A-Za-z0-9+/=]',''; $zip=Join-Path $env:AGYWORK 'payload.zip'; [IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($b64)); Expand-Archive -Force -Path $zip -DestinationPath (Join-Path $env:AGYWORK 'app')"
if not exist "%WORK%\app\localization_engine.js" goto extfail
goto run

:extfail
echo [错误] 文件释放失败。
pause
exit /b 1

:run
echo.
echo 正在执行...
if defined MANUALDIR goto run_manual
"%NODE%" "%WORK%\app\localization_engine.js" %ARGS%
goto afterrun
:run_manual
"%NODE%" "%WORK%\app\localization_engine.js" %ARGS% --install-dir "%AHOME%"
:afterrun
set "RC=%errorlevel%"
rmdir /s /q "%WORK%" 2>nul
if not "%RC%"=="0" goto failed
echo.
echo [完成] 操作成功！
echo 窗口将在 5 秒后自动关闭...
timeout /t 5
exit /b 0

:failed
echo.
echo [失败] 请检查上方错误信息。
pause
exit /b 1
exit /b 0
